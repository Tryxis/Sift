{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "DataProtection": {
    "KeyEncryptionKey": ""
  },
  "Auth": {
    "SessionDays": 30,
    "MaxSessionDays": 90,
    "GuestBrowsing": true,
    "AllowedSteamIds": []
  },
  "Steam": {
    "ApiKey": "",
    "BaseUrl": "https://api.steampowered.com/"
  },
  "Enrichment": {
    "Enabled": true,
    "RunIntervalHours": 24,
    "StartupDelaySeconds": 30,
    "MaxAppsPerRun": 250,
    "HowLongToBeat": {
      "Enabled": true,
      "RefreshAfterDays": 30,
      "RequestDelayMilliseconds": 2500
    },
    "ReviewScores": {
      "Enabled": true,
      "RefreshAfterDays": 7,
      "RequestDelayMilliseconds": 1500
    },
    "StoreDetails": {
      "Enabled": true,
      "RefreshAfterDays": 30,
      "RequestDelayMilliseconds": 1500,
      "MaxAppsPerRun": 300,
      "RateLimitBackoffSeconds": 120,
      "MaxRateLimitBackoffsPerRun": 3
    },
    "Achievements": {
      "Enabled": true,
      "RefreshAfterDays": 7,
      "UnavailableRefreshAfterDays": 90,
      "RequestDelayMilliseconds": 1000,
      "MaxCallsPerRun": 500
    }
  }
}
